# CONFIGURACOES DA APLICACAO CLUBE AURORA
FLASK_APP=app
FLASK_DEBUG=0

# Substitua por uma chave aleatoria e exclusiva do ambiente
SECRET_KEY=

# Caminho do banco de dados SQLite
DATABASE=instance/aurora.db

# Senha inicial para criacao do usuario, se necessaria
SEED_PASSWORD=

# Nao incluir tokens administrativos reais neste arquivo